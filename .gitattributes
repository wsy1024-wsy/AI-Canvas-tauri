# Normalize text files to LF in the repository and on checkout.
# This avoids the "LF will be replaced by CRLF" warnings on Windows
# when Git is configured with core.autocrlf=true.
* text=auto eol=lf

# Common source and config files (redundant but explicit)
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.conf.json text eol=lf

# Tauri generated schemas should also use LF
src-tauri/gen/schemas/*.json text eol=lf

# Treat these as binary and never convert line endings
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.svg       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.pdf       binary
*.zip       binary
*.tar.gz    binary
*.node      binary
*.exe       binary
*.dll       binary
